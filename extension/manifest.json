{
    "manifest_version": 3,
    "name": "🛡️ PhishGuard",
    "version": "1.0",
    "description": "A machine learning-based detector for phishing URLs.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*",
        "https://phishguard-api-p12g.onrender.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}